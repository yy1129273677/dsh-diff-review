{
  "name": "dsh-diff-review",
  "version": "0.4.0",
  "private": true,
  "description": "DSH 文件变更审阅：agent 每改一个文件就列进清单，点击看完整逐行差异，顶部提供「保留 / 撤销」，可在差异块之间跳转、调字号并全屏阅读。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "diff",
    "review",
    "files"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/diff.test.mjs"
  },
  "license": "MIT"
}
